{
  "manifest_version": 3,
  "name": "Slop or Not!",
  "version": "1.0.0",
  "description": "Detect AI-generated slop in your LinkedIn feed. Badges posts as Human or Slop based on 16 writing pattern heuristics. Block slop posts and spot AI reply guys.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
